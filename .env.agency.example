# RMA Platform V2 -- agency server environment (compose.agency.yaml).
# Copy to /data/rma-portal/config/.env ON THE SERVER, mode 0600, never commit it.
#   docker compose --env-file /data/rma-portal/config/.env -f compose.agency.yaml config -q
# Names and safe non-secret defaults only. The five REQUIRED values have no default on
# purpose: the stack refuses to resolve while any of them is empty, and scripts/agency/preflight.sh
# also refuses placeholders.

# --- REQUIRED: immutable image version -------------------------------------------------------------
# 12-character git commit printed by scripts/agency/export-images.sh (never `latest`, never 2.0.0).
# Rollback = set this to the previous bundle's version and restart only the affected services.
RMA_VERSION=

# --- REQUIRED secrets (generate ON THE SERVER, see docs/agency-production-deployment.md) ------------
# PostgreSQL password of the `rma` role. Set once: PostgreSQL stores it at first initialisation.
POSTGRES_PASSWORD=
# Signs employee session cookies. Keep it unchanged across upgrades: changing it logs every user out.
RMA_SESSION_SECRET=
# noVNC administrator desktop password. VNC uses only the FIRST 8 CHARACTERS; the rest is ignored.
RMA_VNC_PASSWORD=
# Authenticates API-to-browser commands on the private Docker network; never sent to employees.
RMA_BROWSER_CONTROL_TOKEN=

# --- Storage --------------------------------------------------------------------------------------------
# Every persistent RMA byte lives below this directory (explicit bind mounts, nothing in /var/lib/docker).
RMA_STORAGE_ROOT=/data/rma-portal

# --- Published ports (RMA is the only writer of these two bindings) ------------------------------------
# Employee portal: server LAN address only (never 0.0.0.0, never the Tailscale address).
RMA_WEB_BIND_IP=192.168.1.32
RMA_WEB_PORT=8480
# Administrator noVNC desktop: agency LAN address only, protected by the VNC password.
RMA_NOVNC_BIND_IP=192.168.1.32
RMA_NOVNC_PORT=6081

# --- Public addresses -----------------------------------------------------------------------------------
RMA_PUBLIC_ORIGIN=http://192.168.1.32:8480
# Opened automatically after an RMA administrator starts a connection from the portal.
RMA_NOVNC_URL=http://192.168.1.32:6081/vnc.html?autoconnect=1&resize=scale
# Trusted-LAN HTTP pilot. HTTPS (and RMA_COOKIE_SECURE=true) is a later, separately approved change.
RMA_COOKIE_SECURE=false

# --- OmegaFlow / behaviour ----------------------------------------------------------------------------
OMEGAFLOW_BASE_URL=https://omegaflow.ma
OMEGAFLOW_START_ROUTE=https://omegaflow.ma/#dossiers-en-instance-accord/
RMA_TIMEZONE=Africa/Casablanca
# 3600 s for the first deployment; 300 s only after acceptance (Stage 14).
RMA_POLL_INTERVAL_SECONDS=3600
RMA_MAX_DETAIL_READS_PER_CYCLE=60
RMA_SCREEN=1440x900x24

# --- AI: DISABLED for the initial deployment -------------------------------------------------------------
# Do not connect RMA to the agency Ollama server until the portal, the OmegaFlow session and all
# 21 workflows are validated. The three values below are unused while RMA_OLLAMA_ENABLED=false.
RMA_OLLAMA_ENABLED=false
RMA_OLLAMA_BASE_URL=http://127.0.0.1:11434
RMA_OLLAMA_MODEL=qwen3:8b
RMA_OLLAMA_TIMEOUT_SECONDS=45

# --- Backups (scripts/agency/backup.sh; always inside ${RMA_STORAGE_ROOT}/backups) -------------------
BACKUP_RETENTION=14
