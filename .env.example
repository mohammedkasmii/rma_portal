# RMA Platform V2 -- production environment (compose.prod.yaml).
# Copy to `.env` (never commit it), replace every "change-me", then:
#   docker compose -f compose.prod.yaml config -q      # syntax + required variables
# The three values marked REQUIRED have no default on purpose.

# --- REQUIRED secrets -------------------------------------------------------------------------
# PostgreSQL password for the `rma` role (used by the API, worker and migrations).
POSTGRES_PASSWORD=change-me-long-random-password
# Signs employee session cookies: `openssl rand -hex 32`. Changing it logs everyone out.
RMA_SESSION_SECRET=change-me-openssl-rand-hex-32
# Password of the noVNC administrator desktop (only the first 8 characters count in VNC).
RMA_VNC_PASSWORD=change-me

# --- Image / stack ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=rma-portal
RMA_VERSION=2.0.0

# --- Published ports (choose free ones; check with `ss -ltn`) -------------------------------------
# Employee web UI (nginx: React + /api). PostgreSQL is never published.
RMA_WEB_PORT=8480
# Administrator noVNC desktop for the OmegaFlow login. The Phase 0 stack uses 6080.
RMA_NOVNC_PORT=6081

# --- Public addresses (as employees/admins type them in a browser) --------------------------------
# Where the "Se connecter / Reconnecter" button sends the administrator.
RMA_NOVNC_URL=http://192.168.1.180:6081/vnc.html
# Extra origin accepted by the same-origin mutation check when the proxy hides the public URL
# (leave empty when Host/scheme are forwarded correctly, which is the default nginx setup).
RMA_PUBLIC_ORIGIN=http://192.168.1.180:8480
# Set true only when the web UI is served over HTTPS (adds the Secure cookie flag).
RMA_COOKIE_SECURE=false

# --- OmegaFlow / behaviour --------------------------------------------------------------------------
OMEGAFLOW_BASE_URL=https://omegaflow.ma
OMEGAFLOW_START_ROUTE=https://omegaflow.ma/#dossiers-en-instance-accord/
RMA_TIMEZONE=Africa/Casablanca
# Seconds between scheduled synchronization cycles.
RMA_POLL_INTERVAL_SECONDS=300
# Upper bound of dossier detail pages read per cycle (the rest continue next cycle).
RMA_MAX_DETAIL_READS_PER_CYCLE=60
RMA_SCREEN=1440x900x24

# --- Optional local AI (Ollama runs on the host, never in this stack) ------------------------------------
# The adapter refuses any non-local endpoint; host.docker.internal reaches the VM's Ollama.
RMA_OLLAMA_ENABLED=false
RMA_OLLAMA_BASE_URL=http://host.docker.internal:11434
RMA_OLLAMA_MODEL=qwen3:8b
RMA_OLLAMA_TIMEOUT_SECONDS=45

# --- Backups (scripts/prod/backup.sh) -----------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION=14
